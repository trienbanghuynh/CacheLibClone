// Mixed workload: ~95% small items (BigHash/SOC) + ~5% large items (BlockCache/LOC)
// Storage: real NVMe device (/dev/nvme0n1) with FDP and io_uring enabled.
// Run with: cachebench --json_test_config mixed_workload.json

{
  "cache_config": {
    "cacheSizeMB": 512,
    "poolRebalanceIntervalSec": 1,
    "moveOnSlabRelease": false,

    "nvmCachePaths": ["/dev/nvme0n1"],
    "nvmCacheSizeMB": 102400,

    "navyBlockSize": 4096,
    "navyRegionSizeMB": 16,

    "navyBigHashSizePct": 10,
    "navySmallItemMaxSize": 2048,
    "navyBigHashBucketSize": 4096,

    "navyAdmissionWriteRate": 104857600,
    "navyMaxConcurrentInserts": 16,
    "navyReaderThreads": 4,
    "navyWriterThreads": 2,

    "navyEnableIoUring": false,
    "deviceEnableFDP": false,
    "navyQDepth": 32
  },
  "test_config": {
    "numOps": 100000,
    "numThreads": 4,
    "numKeys": 1000000,

    "keySizeRange": [8, 32, 64, 128],
    "keySizeRangeProbability": [0.6, 0.3, 0.1],


    "valSizeRange": [64, 512, 4096, 65536, 1048576],
    "valSizeRangeProbability": [0.50, 0.25, 0.15, 0.07, 0.03],

    "getRatio": 0.0,
    "setRatio": 1.0,
    "delRatio": 0.0
  }
}
